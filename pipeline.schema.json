{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xkqg/DeepSharp/main/pipeline.schema.json",
  "title": "A DeepSharp pipeline",
  "description": "The steps of a pipeline in the order they were written, and what the fit learned from the training rows.",
  "type": "object",
  "properties": {
    "version": {
      "description": "The version of the pipeline file this was written against; the first, when it is left out.",
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "declaration": {
      "description": "The steps, in the order they run.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "fitted": {
      "$ref": "#/$defs/fitted"
    }
  },
  "required": [
    "declaration"
  ],
  "additionalProperties": false,
  "$defs": {
    "step": {
      "description": "One step of the pipeline, named by its verb.",
      "type": "object",
      "properties": {
        "step": {
          "enum": [
            "declare",
            "drop.columns",
            "drop.gaps",
            "drop.warmup",
            "encode",
            "encode.categories",
            "evidence.correlation",
            "evidence.profile",
            "feature.add",
            "feature.cyclical",
            "feature.indicator",
            "feature.timeParts",
            "fill.missing",
            "fill.nan",
            "maths",
            "normalise",
            "normalise.row",
            "order.by",
            "outliers.clip",
            "read.csv",
            "read.rows",
            "split.atRandom",
            "split.byTime",
            "split.stratified",
            "target",
            "target.ahead",
            "target.distribution",
            "target.labels"
          ]
        }
      },
      "required": [
        "step"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "step": {
                "const": "declare"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/declare"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "drop.columns"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/drop.columns"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "drop.gaps"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/drop.gaps"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "drop.warmup"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/drop.warmup"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "encode"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/encode"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "encode.categories"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/encode.categories"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "evidence.correlation"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/evidence.correlation"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "evidence.profile"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/evidence.profile"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "feature.add"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/feature.add"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "feature.cyclical"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/feature.cyclical"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "feature.indicator"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/feature.indicator"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "feature.timeParts"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/feature.timeParts"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "fill.missing"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/fill.missing"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "fill.nan"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/fill.nan"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "maths"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/maths"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "normalise"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/normalise"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "normalise.row"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/normalise.row"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "order.by"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/order.by"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "outliers.clip"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/outliers.clip"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "read.csv"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/read.csv"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "read.rows"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/read.rows"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "split.atRandom"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/split.atRandom"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "split.byTime"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/split.byTime"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "split.stratified"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/split.stratified"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "target"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/target"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "target.ahead"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/target.ahead"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "target.distribution"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/target.distribution"
          }
        },
        {
          "if": {
            "properties": {
              "step": {
                "const": "target.labels"
              }
            },
            "required": [
              "step"
            ]
          },
          "then": {
            "$ref": "#/$defs/target.labels"
          }
        }
      ]
    },
    "fitted": {
      "description": "What each step learned from the training rows, written by the fit rather than by a person: an entry for each step that learned something, filed under the key of the steps it learned behind.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "pattern": "\\S"
          },
          "prefix": {
            "description": "The key of the steps up to the one that learned this: a SHA-256 digest, in hexadecimal.",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "learned": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        },
        "required": [
          "step",
          "prefix",
          "learned"
        ],
        "additionalProperties": false
      }
    },
    "declare": {
      "description": "Names the columns that take part, says what each holds, and decides what becomes of the rest.",
      "type": "object",
      "properties": {
        "step": {
          "const": "declare"
        },
        "remainder": {
          "anyOf": [
            {
              "enum": [
                "drop",
                "keep",
                "refuse"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?:[Dd][Rr][Oo][Pp]|[Kk][Ee][Ee][Pp]|[Rr][Ee][Ff][Uu][Ss][Ee])$"
            }
          ],
          "description": "What becomes of the columns the schema does not name: dropped, kept as text, or refused."
        },
        "columns": {
          "description": "The columns that take part, what each holds, and whether the source may lack it.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "\\S",
                "description": "The column's name in the source."
              },
              "kind": {
                "anyOf": [
                  {
                    "enum": [
                      "text",
                      "number",
                      "integer",
                      "boolean",
                      "timestamp",
                      "category"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^(?:[Tt][Ee][Xx][Tt]|[Nn][Uu][Mm][Bb][Ee][Rr]|[Ii][Nn][Tt][Ee][Gg][Ee][Rr]|[Bb][Oo][Oo][Ll][Ee][Aa][Nn]|[Tt][Ii][Mm][Ee][Ss][Tt][Aa][Mm][Pp]|[Cc][Aa][Tt][Ee][Gg][Oo][Rr][Yy])$"
                  }
                ],
                "description": "What the column holds."
              },
              "optional": {
                "description": "Whether the source is allowed not to have the column at all.",
                "type": "boolean"
              },
              "excluded": {
                "description": "Whether the column is left out while its kind is kept, so it can be taken in again as it was. Left out, the column takes part.",
                "type": "boolean"
              },
              "was": {
                "anyOf": [
                  {
                    "enum": [
                      "text",
                      "number",
                      "integer",
                      "boolean",
                      "timestamp",
                      "category"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^(?:[Tt][Ee][Xx][Tt]|[Nn][Uu][Mm][Bb][Ee][Rr]|[Ii][Nn][Tt][Ee][Gg][Ee][Rr]|[Bb][Oo][Oo][Ll][Ee][Aa][Nn]|[Tt][Ii][Mm][Ee][Ss][Tt][Aa][Mm][Pp]|[Cc][Aa][Tt][Ee][Gg][Oo][Rr][Yy])$"
                  }
                ],
                "description": "The kind a category column held before it was made one, so it can go back to it. Left out, there is none."
              }
            },
            "required": [
              "name",
              "kind",
              "optional"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "step",
        "remainder",
        "columns"
      ],
      "additionalProperties": false
    },
    "drop.columns": {
      "description": "Leaves columns out from here on.",
      "type": "object",
      "properties": {
        "step": {
          "const": "drop.columns"
        },
        "columns": {
          "description": "The columns to leave out from here on.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "step",
        "columns"
      ],
      "additionalProperties": false
    },
    "drop.gaps": {
      "description": "Drops every row that has a gap in any of the named columns, before the rows are divided.",
      "type": "object",
      "properties": {
        "step": {
          "const": "drop.gaps"
        },
        "columns": {
          "description": "The columns a row may not have a gap in.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "step",
        "columns"
      ],
      "additionalProperties": false
    },
    "drop.warmup": {
      "description": "Drops the rows at the start that an indicator cannot yet speak for.",
      "type": "object",
      "properties": {
        "step": {
          "const": "drop.warmup"
        },
        "atMost": {
          "description": "The most rows this may drop from the start; beyond it the run stops rather than shrink the data to nothing.",
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "step",
        "atMost"
      ],
      "additionalProperties": false
    },
    "encode": {
      "description": "Writes a column of words down as numbers, using the categories the training rows held.",
      "type": "object",
      "properties": {
        "step": {
          "const": "encode"
        },
        "column": {
          "type": "string",
          "pattern": "\\S",
          "description": "The column of words to write down as numbers."
        },
        "as": {
          "anyOf": [
            {
              "enum": [
                "onehot",
                "ordinal"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?:[Oo][Nn][Ee][Hh][Oo][Tt]|[Oo][Rr][Dd][Ii][Nn][Aa][Ll])$"
            }
          ],
          "description": "How the categories are written down: one column per category, or one column of places."
        },
        "unseen": {
          "anyOf": [
            {
              "enum": [
                "reserve",
                "refuse"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?:[Rr][Ee][Ss][Ee][Rr][Vv][Ee]|[Rr][Ee][Ff][Uu][Ss][Ee])$"
            }
          ],
          "description": "What happens to a category the training rows never held: a place kept for it, or a refusal."
        }
      },
      "required": [
        "step",
        "column",
        "as",
        "unseen"
      ],
      "additionalProperties": false
    },
    "encode.categories": {
      "description": "Writes every column that stands for a group down as numbers, each by the categories the training rows held.",
      "type": "object",
      "properties": {
        "step": {
          "const": "encode.categories"
        },
        "as": {
          "anyOf": [
            {
              "enum": [
                "onehot",
                "ordinal"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?:[Oo][Nn][Ee][Hh][Oo][Tt]|[Oo][Rr][Dd][Ii][Nn][Aa][Ll])$"
            }
          ],
          "description": "How each category is written down: one column per category, or one column of places."
        },
        "unseen": {
          "anyOf": [
            {
              "enum": [
                "reserve",
                "refuse"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?:[Rr][Ee][Ss][Ee][Rr][Vv][Ee]|[Rr][Ee][Ff][Uu][Ss][Ee])$"
            }
          ],
          "description": "What happens to a category the training rows never held: a place kept for it, or a refusal."
        }
      },
      "required": [
        "step",
        "as",
        "unseen"
      ],
      "additionalProperties": false
    },
    "evidence.correlation": {
      "description": "Sets out the rows a correlation between columns is drawn from, on the rows the split trains on, and how many it kept.",
      "type": "object",
      "properties": {
        "step": {
          "const": "evidence.correlation"
        },
        "columns": {
          "description": "The columns to correlate with one another: two or more, each holding numbers.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "shown": {
          "anyOf": [
            {
              "enum": [
                "drawn",
                "numbers"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?:[Dd][Rr][Aa][Ww][Nn]|[Nn][Uu][Mm][Bb][Ee][Rr][Ss])$"
            }
          ],
          "description": "How it is shown: drawn as a coloured grid, or as the numbers themselves."
        }
      },
      "required": [
        "step",
        "columns",
        "shown"
      ],
      "additionalProperties": false
    },
    "evidence.profile": {
      "description": "Profiles the columns where it stands, on the rows the split trains on, and names the step that answers each thing it finds.",
      "type": "object",
      "properties": {
        "step": {
          "const": "evidence.profile"
        },
        "columns": {
          "description": "The columns to profile; left out, every column where the step stands.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "step"
      ],
      "additionalProperties": false
    },
    "feature.add": {
      "description": "Adds a column worked out from two others by plain arithmetic.",
      "type": "object",
      "properties": {
        "step": {
          "const": "feature.add"
        },
        "column": {
          "type": "string",
          "pattern": "\\S",
          "description": "What the new column is called."
        },
        "left": {
          "type": "string",
          "pattern": "\\S",
          "description": "The column on the left of the arithmetic."
        },
        "arithmetic": {
          "anyOf": [
            {
              "enum": [
                "plus",
                "minus",
                "times",
                "dividedby"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?:[Pp][Ll][Uu][Ss]|[Mm][Ii][Nn][Uu][Ss]|[Tt][Ii][Mm][Ee][Ss]|[Dd][Ii][Vv][Ii][Dd][Ee][Dd][Bb][Yy])$"
            }
          ],
          "description": "What is done with the two columns: added, subtracted, multiplied or divided."
        },
        "right": {
          "type": "string",
          "pattern": "\\S",
          "description": "The column on the right of the arithmetic."
        }
      },
      "required": [
        "step",
        "column",
        "left",
        "arithmetic",
        "right"
      ],
      "additionalProperties": false
    },
    "feature.cyclical": {
      "description": "Writes a moment in time as a place on a circle, so that the ends of a cycle meet.",
      "type": "object",
      "properties": {
        "step": {
          "const": "feature.cyclical"
        },
        "column": {
          "type": "string",
          "pattern": "\\S",
          "description": "The column holding the moment in time."
        },
        "period": {
          "anyOf": [
            {
              "enum": [
                "hourofday",
                "dayofweek",
                "dayofmonth",
                "monthofyear"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?:[Hh][Oo][Uu][Rr][Oo][Ff][Dd][Aa][Yy]|[Dd][Aa][Yy][Oo][Ff][Ww][Ee][Ee][Kk]|[Dd][Aa][Yy][Oo][Ff][Mm][Oo][Nn][Tt][Hh]|[Mm][Oo][Nn][Tt][Hh][Oo][Ff][Yy][Ee][Aa][Rr])$"
            }
          ],
          "description": "Which cycle the moment is placed on: the hour of the day, the day of the week or of the month, the month of the year."
        },
        "form": {
          "anyOf": [
            {
              "enum": [
                "signed",
                "unit",
                "splitsign"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?:[Ss][Ii][Gg][Nn][Ee][Dd]|[Uu][Nn][Ii][Tt]|[Ss][Pp][Ll][Ii][Tt][Ss][Ii][Gg][Nn])$"
            }
          ],
          "description": "How the two values are written down: as they are, shifted between nothing and one, or split into how far up and how far down."
        }
      },
      "required": [
        "step",
        "column",
        "period",
        "form"
      ],
      "additionalProperties": false
    },
    "feature.indicator": {
      "description": "Adds a market indicator worked out from the rows that came before: an average, a strength index, a band.",
      "type": "object",
      "properties": {
        "step": {
          "const": "feature.indicator"
        },
        "column": {
          "type": "string",
          "pattern": "\\S",
          "description": "What the new column is called; an indicator with several parts adds a suffix for each."
        },
        "indicator": {
          "anyOf": [
            {
              "enum": [
                "sma",
                "ema",
                "rsi",
                "atr",
                "adx",
                "cci",
                "williamsr",
                "obv",
                "macd",
                "bollingerbands",
                "stochastic",
                "vwap"
              ]
            },
            {
              "type": "string",
