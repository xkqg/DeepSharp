<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>DeepSharp.Pipelines.Parquet</PackageId>
    <Description>Reads a DeepSharp pipeline's rows out of an Apache Parquet file: .ReadParquet(path) in the chain, read.parquet in a pipeline file, replayed like any other file the pipeline reads. The file says what each of its columns holds, and the proposal of kinds takes what it says; every value is handed over as the text the pipeline reads, one way for every typed source, and a column of lists, groups or raw bytes is refused by name rather than flattened by guesswork.</Description>
    <PackageTags>machine-learning;pipeline;parquet;apache-parquet;data-preparation;etl;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Parquet.Net 6.1.0, MIT (github.com/aloneguid/parquet-dotnet): a fully managed reader, borrowed rather than written.
         It brings CommunityToolkit.HighPerformance 8.4.2 (MIT), K4os.Compression.LZ4 1.3.8 (MIT),
         Microsoft.IO.RecyclableMemoryStream 3.0.1 (MIT), Snappier 1.3.1 (BSD-3-Clause) and ZstdSharp.Port 0.8.8 (MIT). -->
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeepSharp.Pipelines\DeepSharp.Pipelines.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
