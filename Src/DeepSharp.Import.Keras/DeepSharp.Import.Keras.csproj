<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>DeepSharp.Import.Keras</PackageId>
    <Description>Reads a model Keras 3 saved into a DeepSharp network: the .keras archive it saves a model to, or the HDF5 file it saved one to before. The layers its description names are built as DeepSharp's words in Keras's meaning build them — a batch normalisation keeping Keras's epsilon and the complement of its momentum, a window padded as TensorFlow's 'same', or 'causal' along a series, walking a series, an image or a volume in its convolutions and its poolings, global poolings and dropouts of whole channels — each activation a layer of its own and the last one the loss applies itself lifted into that loss; its numbers go into the network's slots as Keras lays them out, strictly, every fault named at once where the file holds it. What no network here is built of — a stride of its own for each axis, a dilated window, channels in groups, a layer of any other kind — is refused at its layer.</Description>
    <PackageTags>deepsharp;keras;tensorflow;hdf5;import;neural-network;deep-learning;machine-learning;dotnet</PackageTags>
    <!-- A file is read with .NET's JSON reader by hand, never through its serializer, which an application that trims itself
         or is compiled ahead of time — a .NET 10 file-based program is, unless it says otherwise — has no reflection for:
         the serializer there refused the first setting read (measured). The analyser makes any call that needs such
         reflection a warning, and so a failed build. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- PureHDF 2.2.0, MIT (github.com/Apollo3zehn/PureHDF): a fully managed reader of HDF5 files, borrowed rather than
         written. It brings nothing else: its package names no dependency for .NET 8. The archive and the description are
         read with .NET's own zip and JSON readers. -->
    <PackageReference Include="PureHDF" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeepSharp\DeepSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
