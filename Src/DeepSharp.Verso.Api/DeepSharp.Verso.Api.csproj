<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>DeepSharp.Verso.Api</PackageId>
    <Description>An application of your own that hosts DeepSharp's notebook: Verso's engine with the notebook's parts registered by the package itself, one open notebook for each file however many views show it, and its cells and what they show as plain values.</Description>
    <PackageTags>deepsharp;pipeline;pdd;machine-learning;data-preparation;verso;notebook;hosting;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Verso's engine itself, which the notebook package never carries: an application that hosts notebooks runs
         them, so it needs the engine, and this is the package that brings it. -->
    <PackageReference Include="Verso" Version="1.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeepSharp.Verso.Notebooks\DeepSharp.Verso.Notebooks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine behind a host is internal; the suite measures what only it can say. -->
    <InternalsVisibleTo Include="DeepSharp.Verso.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
