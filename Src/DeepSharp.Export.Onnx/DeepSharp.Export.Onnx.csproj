<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>DeepSharp.Export.Onnx</PackageId>
    <Description>Writes a DeepSharp network as an ONNX graph that any ONNX runtime answers through: new OnnxExport(each).Write(network, loss, stream). Each step of the network is written as the operators of the oldest operator set that holds them — a dense layer as a MatMul and the Add of its bias, a low-rank pair as the extra products it is, the normalisations, activations and joins of a network whose paths meet — its numbers as the graph's initializers named by the slot's path, and the output activation its loss applies itself as the last node. The graph is the one DeepSharp's ONNX reader reads back into the same numbers. A network written as code has no declared order and is refused by name, and so is every layer that has no ONNX operator to be written as.</Description>
    <PackageTags>deepsharp;onnx;export;neural-network;deep-learning;machine-learning;dotnet</PackageTags>
    <!-- A graph is written by hand from the messages protobuf generates, never through a serializer that needs reflection, which
         an application that trims itself or is compiled ahead of time has none of. The analyser makes any call that needs
         such reflection a warning, and so a failed build. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- The messages of ONNX's own onnx.proto, generated for .NET: the same package the reader of a graph takes (see
         DeepSharp.Import.Onnx), for the same reasons. -->
    <PackageReference Include="OnnxSharp" Version="0.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeepSharp\DeepSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The suite that runs what is written reads which layers are written, so no layer added to the library goes unsaid here. -->
    <InternalsVisibleTo Include="DeepSharp.Export.Onnx.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- How ONNX lays a number out and how a slot here keeps it, in both directions: the one home of every such rule, compiled
         into the package that reads a graph and into this one that writes it, so the two cannot come to disagree. -->
    <Compile Include="..\DeepSharp.Import.Onnx\OnnxLayouts.cs" Link="OnnxLayouts.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
