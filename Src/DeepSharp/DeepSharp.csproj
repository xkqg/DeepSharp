<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>DeepSharp</PackageId>
    <Description>Deep learning in C#: build a network by stacking layers, compile it and fit it, or write the forward pass yourself — both reach the same model. Tensors and automatic differentiation run on .NET's own SIMD primitives, with no native dependency, and every run can draw its own training curves.</Description>
    <PackageTags>deep-learning;machine-learning;neural-network;tensor;autograd;tensorflow;pytorch;torchsharp;keras;dotnet</PackageTags>
    <InternalsVisibleTo>DeepSharp.Tests</InternalsVisibleTo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
