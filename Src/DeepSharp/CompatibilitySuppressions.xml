  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:DeepSharp.Tensors.Window.get_Stride</Target>
    <Left>lib/net10.0/DeepSharp.dll</Left>
    <Right>lib/net10.0/DeepSharp.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
