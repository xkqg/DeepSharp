<?xml version="1.0" encoding="utf-8"?>
<!-- https://learn.microsoft.com/dotnet/fundamentals/package-validation/diagnostic-ids -->
<!--
  Every entry here is a difference from the baseline the packages are compared against, which is the newest release on
  nuget.org: 0.10.0.

  The tensor seam gained ITensorBackend.Sin and ITensorBackend.Erf. The sine is what the periodic embedding turns a number
  round with, and the error function is what the exact GELU is written in, which no operation the seam had composes. An
  engine written outside the library has two more operations to write, and the comparison says so, once for each operation
  and each target framework: a meant break, named in the changelog's upgrading notes.
-->
<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Suppression>
    <DiagnosticId>CP0006</DiagnosticId>
    <Target>M:DeepSharp.Tensors.ITensorBackend.Erf(DeepSharp.Tensors.Tensor)</Target>
    <Left>lib/net10.0/DeepSharp.dll</Left>
    <Right>lib/net10.0/DeepSharp.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0006</DiagnosticId>
    <Target>M:DeepSharp.Tensors.ITensorBackend.Sin(DeepSharp.Tensors.Tensor)</Target>
    <Left>lib/net10.0/DeepSharp.dll</Left>
    <Right>lib/net10.0/DeepSharp.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0006</DiagnosticId>
    <Target>M:DeepSharp.Tensors.ITensorBackend.Erf(DeepSharp.Tensors.Tensor)</Target>
    <Left>lib/net8.0/DeepSharp.dll</Left>
    <Right>lib/net8.0/DeepSharp.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
