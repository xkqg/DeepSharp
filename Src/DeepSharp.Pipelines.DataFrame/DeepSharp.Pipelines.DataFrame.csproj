<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>DeepSharp.Pipelines.DataFrame</PackageId>
    <Description>Reads a DeepSharp pipeline's rows out of a Microsoft.Data.Analysis DataFrame, or out of anything that can fill one: a comma-separated file, a database query, rows somebody already had. One reader for the long tail of formats, so the pipeline itself needs none of them. An absent value stays absent rather than becoming a not-a-number, because never-there and arithmetic-went-wrong are different answers.</Description>
    <PackageTags>machine-learning;pipeline;dataframe;data-preparation;etl;sql;csv;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Analysis" Version="0.23.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeepSharp.Pipelines\DeepSharp.Pipelines.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
