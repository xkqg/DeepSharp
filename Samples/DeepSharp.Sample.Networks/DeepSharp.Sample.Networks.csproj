<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- A sample is read as much as it is run, so it is held to the same build as the library: no warnings, and the
         analyser that finds an unused using needs the documentation file to exist. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\DeepSharp\DeepSharp.csproj" />
    <ProjectReference Include="..\..\Src\DeepSharp.Pipelines\DeepSharp.Pipelines.csproj" />
    <ProjectReference Include="..\..\Src\DeepSharp.Learners.Networks\DeepSharp.Learners.Networks.csproj" />
    <ProjectReference Include="..\..\Src\DeepSharp.Charts\DeepSharp.Charts.csproj" />
  </ItemGroup>

</Project>
