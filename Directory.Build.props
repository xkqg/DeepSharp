<Project>

  <PropertyGroup>
    <Authors>H.P. Gansevoort</Authors>
    <Copyright>Copyright (c) 2026 H.P. Gansevoort</Copyright>
    <PackageProjectUrl>https://github.com/xkqg/DeepSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xkqg/DeepSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- One number for every packable project. It is handed out when the work starts, never invented here,
         and the changelog heading carries the same one. -->
    <Version>0.1.0</Version>

    <!-- Which frameworks a project targets is the project's own business: the library ships for two, the
         test runner is an executable for one. Setting it here made the test project inherit both and then
         refuse to run, having two entry points to choose between. -->
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- A warning is a failure that has not happened yet. The build ends at zero of both, everywhere. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Deterministic and reproducible: the same source produces the same assembly. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Source Link: a stack trace from a released package steps straight into the commit it was built from. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

</Project>
