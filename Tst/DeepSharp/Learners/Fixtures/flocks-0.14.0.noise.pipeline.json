{
  "version": 13,
  "declaration": [
    {
      "step": "read.csv",
      "path": "flocks-0.14.0.csv"
    },
    {
      "step": "declare",
      "remainder": "drop",
      "columns": [
        {
          "name": "Date",
          "kind": "timestamp",
          "optional": false
        },
        {
          "name": "Seq",
          "kind": "integer",
          "optional": false
        },
        {
          "name": "Farm",
          "kind": "category",
          "optional": false
        },
        {
          "name": "Animals",
          "kind": "number",
          "optional": false
        },
        {
          "name": "Age",
          "kind": "number",
          "optional": false
        },
        {
          "name": "b1",
          "kind": "number",
          "optional": false
        },
        {
          "name": "b2",
          "kind": "number",
          "optional": false
        },
        {
          "name": "b3",
          "kind": "number",
          "optional": false
        },
        {
          "name": "b4",
          "kind": "number",
          "optional": false
        },
        {
          "name": "b5",
          "kind": "number",
          "optional": false
        },
        {
          "name": "Temp",
          "kind": "number",
          "optional": true
        }
      ]
    },
    {
      "step": "order.by",
      "columns": [
        "Date",
        "Seq"
      ]
    },
    {
      "step": "feature.add",
      "column": "animalsPerDay",
      "left": "Animals",
      "arithmetic": "dividedby",
      "right": "Age"
    },
    {
      "step": "split.byTime",
      "column": "Date",
      "train": 0.7,
      "validation": 0.15,
      "test": 0.15,
      "predict": 0,
      "gap": 1
    },
    {
      "step": "target.distribution",
      "columns": [
        "b1",
        "b2",
        "b3",
        "b4",
        "b5"
      ],
      "scaleBy": "Animals"
    },
    {
      "step": "normalise.row",
      "norm": "l1",
      "columns": [
        "b1",
        "b2",
        "b3",
        "b4",
        "b5"
      ]
    },
    {
      "step": "history",
      "key": "Farm",
      "value": "Age",
      "orderBy": [
        "Date",
        "Seq"
      ],
      "shrink": 3
    },
    {
      "step": "evidence.likeness",
      "warnAbove": 0.2,
      "columns": [
        "Age",
        "Farm",
        "Temp"
      ]
    },
    {
      "step": "watch.reference",
      "warnAbove": 0.2,
      "columns": [
        "Age",
        "Farm",
        "Temp"
      ]
    },
    {
      "step": "drop.columns",
      "columns": [
        "Date",
        "Seq",
        "Animals"
      ]
    },
    {
      "step": "fill.missing",
      "column": "Temp",
      "with": "median"
    },
    {
      "step": "encode.piecewise",
      "column": "Temp",
      "bins": 4,
      "outOfRange": "clip"
    },
    {
      "step": "encode.categories",
      "as": "onehot",
      "unseen": "reserve"
    },
    {
      "step": "normalise",
      "column": "Age",
      "scale": "midrange",
      "outOfRange": "pass"
    },
    {
      "step": "normalise",
      "column": "animalsPerDay",
      "scale": "midrange",
      "outOfRange": "pass"
    },
    {
      "step": "normalise",
      "column": "Age_history_Farm",
      "scale": "midrange",
      "outOfRange": "pass"
    },
    {
      "step": "evidence.report",
      "metrics": [
        "rmse",
        "mae",
        "mape"
      ],
      "parts": [
        "validation",
        "test"
      ],
      "shown": [
        "numbers"
      ]
    },
    {
      "step": "learn.network",
      "layers": [
        {
          "kind": "gaussianNoise",
          "spread": 0.05,
          "seed": 3
        },
        {
          "kind": "dense",
          "units": 8
        },
        {
          "kind": "relu"
        },
        {
          "kind": "dense",
          "units": 5
        }
      ],
      "optimizer": {
        "kind": "adam",
        "rate": 0.01,
        "firstMoment": 0.9,
        "secondMoment": 0.999,
        "epsilon": 1E-08
      },
      "loss": {
        "kind": "crossEntropy"
      },
      "stopping": {
        "kind": "never"
      },
      "engine": "light",
      "seed": 20261017,
      "epochs": 3,
      "batch": 16
    }
  ]
}