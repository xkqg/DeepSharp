{
  "version": 12,
  "declaration": [
    {
      "step": "read.csv",
      "path": "flocks-0.13.0.csv"
    },
    {
      "step": "declare",
      "remainder": "drop",
      "columns": [
        {
          "name": "Farm",
          "kind": "category",
          "optional": false
        },
        {
          "name": "Animals",
          "kind": "number",
          "optional": false
        },
        {
          "name": "Age",
          "kind": "number",
          "optional": false
        }
      ]
    },
    {
      "step": "scale.given",
      "column": "Animals",
      "lowest": 15000,
      "highest": 25000,
      "lands": "signed"
    },
    {
      "step": "split.atRandom",
      "train": 0.5,
      "validation": 0.1,
      "test": 0.2,
      "predict": 0,
      "calibration": 0.2,
      "seed": 5,
      "testSeed": 9
    },
    {
      "step": "target",
      "column": "Age"
    },
    {
      "step": "encode.categories",
      "as": "onehot",
      "unseen": "reserve"
    },
    {
      "step": "evidence.report",
      "metrics": [
        "mae",
        "coverage",
        "width"
      ],
      "parts": [
        "validation",
        "test"
      ],
      "shown": [
        "numbers"
      ]
    },
    {
      "step": "learn.network",
      "layers": [
        {
          "kind": "dense",
          "units": 8
        },
        {
          "kind": "relu"
        },
        {
          "kind": "dense",
          "units": 1
        }
      ],
      "optimizer": {
        "kind": "adam",
        "rate": 0.01,
        "firstMoment": 0.9,
        "secondMoment": 0.999,
        "epsilon": 1E-08
      },
      "loss": {
        "kind": "meanSquaredError"
      },
      "stopping": {
        "kind": "never"
      },
      "engine": "light",
      "seed": 20261017,
      "epochs": 3,
      "batch": 16
    }
  ]
}