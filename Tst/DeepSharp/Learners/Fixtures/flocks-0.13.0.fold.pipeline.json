{
  "version": 12,
  "declaration": [
    {
      "step": "read.csv",
      "path": "flocks-0.13.0.csv"
    },
    {
      "step": "declare",
      "remainder": "drop",
      "columns": [
        {
          "name": "Farm",
          "kind": "category",
          "optional": false
        },
        {
          "name": "Heavy",
          "kind": "boolean",
          "optional": false
        },
        {
          "name": "Animals",
          "kind": "number",
          "optional": false
        },
        {
          "name": "Age",
          "kind": "number",
          "optional": false
        }
      ]
    },
    {
      "step": "scale.given",
      "column": "Animals",
      "lowest": 15000,
      "highest": 25000,
      "lands": "signed"
    },
    {
      "step": "split.atRandom",
      "train": 0.8,
      "validation": 0,
      "test": 0.2,
      "predict": 0,
      "seed": 42,
      "testSeed": 99,
      "folds": 3,
      "fold": 1
    },
    {
      "step": "target",
      "column": "Heavy"
    },
    {
      "step": "encode.categories",
      "as": "onehot",
      "unseen": "reserve"
    },
    {
      "step": "normalise",
      "column": "Age",
      "scale": "midrange",
      "outOfRange": "pass"
    },
    {
      "step": "learn.network",
      "layers": [
        {
          "kind": "dense",
          "units": 4
        },
        {
          "kind": "relu"
        },
        {
          "kind": "dense",
          "units": 1
        }
      ],
      "optimizer": {
        "kind": "adam",
        "rate": 0.01,
        "firstMoment": 0.9,
        "secondMoment": 0.999,
        "epsilon": 1E-08
      },
      "loss": {
        "kind": "binaryCrossEntropy"
      },
      "stopping": {
        "kind": "never"
      },
      "engine": "light",
      "seed": 20261017,
      "epochs": 3,
      "batch": 16
    }
  ]
}