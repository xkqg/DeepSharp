{
  "version": 11,
  "declaration": [
    {
      "step": "read.csv",
      "path": "flocks-0.12.0.csv"
    },
    {
      "step": "declare",
      "remainder": "drop",
      "columns": [
        {
          "name": "Farm",
          "kind": "category",
          "optional": false
        },
        {
          "name": "Heavy",
          "kind": "boolean",
          "optional": false
        },
        {
          "name": "Animals",
          "kind": "number",
          "optional": false
        },
        {
          "name": "Age",
          "kind": "number",
          "optional": false
        }
      ]
    },
    {
      "step": "scale.given",
      "column": "Animals",
      "lowest": 15000,
      "highest": 25000,
      "lands": "signed"
    },
    {
      "step": "split.stratified",
      "column": "Heavy",
      "train": 0.7,
      "validation": 0.15,
      "test": 0.15,
      "predict": 0,
      "seed": 7
    },
    {
      "step": "target",
      "column": "Heavy"
    },
    {
      "step": "encode.categories",
      "as": "onehot",
      "unseen": "reserve"
    },
    {
      "step": "normalise",
      "column": "Age",
      "scale": "midrange",
      "outOfRange": "pass"
    },
    {
      "step": "evidence.report",
      "metrics": [
        "f1",
        "auc",
        "brier"
      ],
      "parts": [
        "validation",
        "test"
      ],
      "shown": [
        "numbers"
      ]
    },
    {
      "step": "learn.network",
      "layers": [
        {
          "kind": "dense",
          "units": 4
        },
        {
          "kind": "relu"
        },
        {
          "kind": "dense",
          "units": 1
        }
      ],
      "optimizer": {
        "kind": "adam",
        "rate": 0.01,
        "firstMoment": 0.9,
        "secondMoment": 0.999,
        "epsilon": 1E-08
      },
      "loss": {
        "kind": "focal",
        "gamma": 2,
        "alpha": 0.25
      },
      "stopping": {
        "kind": "never"
      },
      "engine": "light",
      "seed": 20261017,
      "epochs": 3,
      "batch": 16
    }
  ]
}