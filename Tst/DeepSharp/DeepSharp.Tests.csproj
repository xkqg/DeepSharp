<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The documentation file is generated but not demanded: the analyser that finds unused usings only
         runs when it exists, while a test's name is its documentation and a <summary> repeating it would be
         the prose this project refuses to write. So the file is on and CS1591 is off, here only. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- xunit.v3 writes its own entry point, and the testing platform writes a second one that can never be
         used. The compiler says so (CS8892) and this build treats a warning as the failure it is, so the
         unused one is not generated at all. -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.*" />
    <!-- A real container, so the registration tests prove what a hosted application would actually get. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <!-- A real database for the one test that asks whether a provider's reader arrives as rows. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.*" />
    <!-- An outside JSON Schema validator, here only, to prove that the schema the steps describe accepts
         what the library writes and refuses what its reader refuses. The core has no business carrying one. -->
    <PackageReference Include="Corvus.Json.Validator" Version="5.*" />
    <!-- A clock a test advances, so the landing's pacing and its retries are tested without waiting for either. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.*" />
    <!-- The README's example is compiled and run as it stands on the page, so the page cannot drift from the code. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\DeepSharp\DeepSharp.csproj" />
    <ProjectReference Include="..\..\Src\DeepSharp.Charts\DeepSharp.Charts.csproj" />
    <ProjectReference Include="..\..\Src\DeepSharp.Import.PyTorch\DeepSharp.Import.PyTorch.csproj" />
    <ProjectReference Include="..\..\Src\DeepSharp.Learners.ML\DeepSharp.Learners.ML.csproj" />
    <ProjectReference Include="..\..\Src\DeepSharp.Learners.Networks\DeepSharp.Learners.Networks.csproj" />
    <ProjectReference Include="..\..\Src\DeepSharp.Pipelines\DeepSharp.Pipelines.csproj" />
    <ProjectReference Include="..\..\Src\DeepSharp.Pipelines.Binance\DeepSharp.Pipelines.Binance.csproj" />
    <ProjectReference Include="..\..\Src\DeepSharp.Pipelines.DataFrame\DeepSharp.Pipelines.DataFrame.csproj" />
    <ProjectReference Include="..\..\Src\DeepSharp.Pipelines.Excel\DeepSharp.Pipelines.Excel.csproj" />
    <ProjectReference Include="..\..\Src\DeepSharp.Pipelines.Indicators\DeepSharp.Pipelines.Indicators.csproj" />
    <ProjectReference Include="..\..\Src\DeepSharp.Pipelines.Json\DeepSharp.Pipelines.Json.csproj" />
    <ProjectReference Include="..\..\Src\DeepSharp.Pipelines.Parquet\DeepSharp.Pipelines.Parquet.csproj" />
    <!-- The samples are run as they stand, so the page cannot drift from the code. -->
    <ProjectReference Include="..\..\Samples\DeepSharp.Sample.Networks\DeepSharp.Sample.Networks.csproj" />
    <ProjectReference Include="..\..\Samples\DeepSharp.Sample.Pipelines\DeepSharp.Sample.Pipelines.csproj" />
    <!-- The reader of what Keras saved, a package of its own. -->
    <ProjectReference Include="..\..\Src\DeepSharp.Import.Keras\DeepSharp.Import.Keras.csproj" />
    <!-- The reader of the ONNX graphs PyTorch exports, a package of its own. -->
    <ProjectReference Include="..\..\Src\DeepSharp.Import.Onnx\DeepSharp.Import.Onnx.csproj" />
    <!-- Importers written outside the core's internals, so what they put into a network is what a reader of somebody else's can. -->
    <ProjectReference Include="..\DeepSharp.Import.TestParts\DeepSharp.Import.TestParts.csproj" />
    <!-- Engines written outside the core's internals, so what they do is what an engine of somebody else's can do. -->
    <ProjectReference Include="..\DeepSharp.Backends.TestParts\DeepSharp.Backends.TestParts.csproj" />
    <!-- What every engine is held to, run here on the light engine and on the tests' own native one. -->
    <ProjectReference Include="..\DeepSharp.Backends.Contract\DeepSharp.Backends.Contract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The files the readers' tests read, and the two programs that wrote them once; those are not part of this build. -->
    <Compile Remove="Pipelines\Fixtures\**" />
    <!-- What PyTorch and Keras saved and the ONNX graphs exported that the importers' tests read, and the programs that
         wrote the rows they trained on; those programs are not part of this build. -->
    <Compile Remove="Import\Fixtures\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Files an earlier release wrote, read by this one as a person's application would read them. -->
    <None Update="Learners\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
