<Project Sdk="Microsoft.NET.Sdk">

  <!-- Engines the core's tests hand a network, written in an assembly of their own as an engine of somebody else's would
       be: the core opens its internals to DeepSharp.Tests alone, so whatever an engine here does, it does through what
       DeepSharp publishes. Not a suite, and not a package: nothing measures it and nothing ships it. -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>DeepSharp.Tests.Backends.Parts</RootNamespace>
    <!-- The native engine works its arithmetic out where its values live, in memory allocated outside .NET, as libtorch
         does; a span over such memory is made from a pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\DeepSharp\DeepSharp.csproj" />
  </ItemGroup>

</Project>
