<Project Sdk="Microsoft.NET.Sdk">

  <!-- A suite of its own: it starts DeepSharp's server for real, on this computer, on a port the system picks, and
       asks it what a browser asks it. -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>DeepSharp.Tests.Serve</RootNamespace>
    <!-- As in the other suites: the documentation file switches the unused-using analyser on, and a test's name is
         its documentation. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="xunit.v3" Version="4.*" />
    <!-- The page is tested in a real browser: the installed Edge on Windows, the Chromium the workflow installs
         elsewhere. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\DeepSharp.Verso.Serve\DeepSharp.Verso.Serve.csproj" />
    <!-- A part the notebooks carry beside the application, as a third party's would be: the engine finds it there. -->
    <ProjectReference Include="..\DeepSharp.Verso.Serve.TestParts\DeepSharp.Verso.Serve.TestParts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One way to find the repository and the data the samples read, shared with the other suites. -->
    <Compile Include="..\DeepSharp\Repository.cs" Link="Repository.cs" />
    <!-- The parameter rule, read from the packages this suite references: each suite reads its own. -->
    <Compile Include="..\DeepSharp\ParameterListTests.cs" Link="ParameterListTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
