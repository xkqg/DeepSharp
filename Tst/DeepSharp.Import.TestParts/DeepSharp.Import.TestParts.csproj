<Project Sdk="Microsoft.NET.Sdk">

  <!-- Importers the core's tests read files with, written in an assembly of their own as a reader of somebody else's
       would be: the core opens its internals to DeepSharp.Tests alone, so whatever an importer here puts into a network,
       it puts in through what DeepSharp publishes. Not a suite, and not a package: nothing measures it and nothing ships it. -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>DeepSharp.Tests.Import.Parts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Src\DeepSharp\DeepSharp.csproj" />
  </ItemGroup>

</Project>
