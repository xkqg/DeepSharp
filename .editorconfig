root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{yml,yaml,json,md}]
indent_size = 2

[*.cs]
# Braces on their own line, and always present: a one-line if without them is one careless edit away from
# meaning something else.
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:error

# Say the type when it is not obvious from the line, and use var when it is.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Modern C#, enforced rather than suggested where it changes behaviour or safety.
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_readonly_field = true:warning

# A private field is _named like one, so a shared field can never be mistaken for a local.
dotnet_naming_rule.private_fields_are_underscored.severity = warning
dotnet_naming_rule.private_fields_are_underscored.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscored.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# Unused usings are dead weight in every file that copies them.
dotnet_diagnostic.IDE0005.severity = warning
